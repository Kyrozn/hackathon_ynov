FROM phi3.5

# Le dataset finance_dataset_final_clean.json a été utilisé pour entraîner l'adapter ci-dessus.
SYSTEM """Tu es un expert en finance.
Tu réponds précisément sur :
- marchés financiers
- obligations
- actions
- gestion des risques
- produits dérivés
"""

PARAMETER temperature 0.3
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_predict 512
PARAMETER num_ctx 4096
PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
